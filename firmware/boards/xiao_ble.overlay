/*
 * Devicetree overlay for the actual v1 hardware: Seeed Studio XIAO nRF52840 (XIAO BLE)
 * + ePaper Driver Board for XIAO + a 4.2" 400x300 monochrome eInk panel (SSD1683
 * controller, e.g. GDEY042T81/T91).
 *
 * Untested — written from Seeed's published pin table for the ePaper Driver Board
 * (wiki.seeedstudio.com/xiao_eink_expansion_board_v2), the standard XIAO nRF52840
 * D-pin -> nRF52840 GPIO mapping, and the SSD1683 datasheet (Solomon Systech, Rev 1.0,
 * Jan 2021) for the SPI framing (4-wire SPI: SCL/SDA/D-C#/CS#, MSB first). Verify
 * against your actual board revision and NCS/Zephyr version before flashing — see
 * firmware/README.md.
 *
 * XIAO D-pin -> nRF52840 GPIO (Seeed's standard XIAO BLE pinout):
 *   D0 = P0.02   D1 = P0.03   D2 = P0.28   D3 = P0.29
 *   D4 = P0.04   D5 = P0.05   D6 = P1.11   D7 = P1.12
 *   D8 = P1.13   D9 = P1.14   D10 = P1.15
 *
 * ePaper Driver Board pin table:
 *   RST=D0  CS=D1  DC=D3  BUSY=D5  SCK=D8  MOSI=D10
 *
 * BUSY=D5 was verified against the physical board. The rest of this row still comes from
 * Seeed's published wiki table, which had BUSY on D2 — demonstrably wrong here, so treat
 * the unverified entries with suspicion if anything else misbehaves. D2 is not used by
 * the panel at all and now carries a checklist button instead (see `buttons` below).
 *
 * Checklist row buttons (this feature): D2, D4, D6, D7, D9 are the pins the ePaper board
 * and battery ADC leave free — wired one per row, active-low to GND with the SoC's
 * internal pull-up (see `buttons` node below).
 *
 * D5 is NOT among them: it is the panel's BUSY line. It was originally listed here as a
 * free button pin because the ePaper pin table above wrongly placed BUSY on D2, so both
 * ends of that mistake had to be corrected together — row 1's button moved D5 -> D2.
 *
 * These GPIO numbers are transcribed from Seeed's published XIAO nRF52840 pinout diagram
 * and, apart from D5, are not cross-checked against a physical board — verify against the
 * actual silkscreen before wiring real buttons.
 *
 * Battery sense (documented on the Seeed forum for XIAO nRF52840): P0.31 is AIN7, the
 * ADC input for the VBAT divider; P0.14 is the divider's active-low enable pin. See
 * battery.c for why P0.14 is held low permanently rather than toggled per-read (a
 * known hardware risk to P0.31 if driven high while configured as an analog input).
 *
 * Charge status (documented on the Seeed forum for XIAO nRF52840): P0.17 is wired
 * on-module to the onboard BQ25101 charger IC's CHG output, the same signal that drives
 * the board's charging LED — driven low while charging, high when not charging or
 * charge-complete. Like P0.31/P0.14 above, this is an internal XIAO pin, not one of the
 * D0-D10 header pins, so it doesn't compete with the panel/button wiring in this file.
 */

&pinctrl {
	spi3_epd: spi3_epd {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 15)>;
		};
	};
};

&spi3 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi3_epd>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>; /* D1 = CS */

	epd: epd@0 {
		/* No dedicated Zephyr binding for this panel family exists, so
		 * epaper.c pulls this as a raw spi_dt_spec (SPI_DT_SPEC_GET) rather
		 * than through a display-class driver — reg/spi-max-frequency are all
		 * that macro actually needs. Depending on your Zephyr/NCS version's
		 * devicetree tooling strictness, an unrecognized `compatible` here may
		 * warn (usually harmless) or require a matching bindings/*.yaml file
		 * in this app — add one if your build complains.
		 */
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <4000000>; /* conservative; SSD1683 supports more,
						 * raise once verified on real hardware */
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};

/ {
	chosen {
		/*
		 * LVGL's Zephyr module (zephyr/modules/lvgl/lvgl.c) is compiled
		 * unconditionally under CONFIG_LVGL and #errors at preprocess time unless a
		 * `zephyr,display` chosen node exists — it has no "I'll drive my own
		 * display" mode. This project deliberately does *not* go through Zephyr's
		 * display subsystem for the panel (see epaper_ssd1683.c and the SSD1683
		 * driver detour that was tried and reverted): the SSD1683 driver here is
		 * the hardware-proven one and stays.
		 *
		 * So this points at a dummy display purely to satisfy that build-time
		 * requirement. Nothing renders through it. The real rendering path creates
		 * its own lv_display sized to the panel and flushes into the 1bpp
		 * framebuffer that epd_ssd1683_push_full() already takes.
		 */
		zephyr,display = &lvgl_dummy_display;
	};

	/* Far smaller than the panel's 400x300 so the buffers LVGL's module allocates for
	 * this never-used display cost bytes instead of kilobytes. Not smaller still: the
	 * module sizes the buffer as a percentage of the display (CONFIG_LV_Z_VDB_SIZE,
	 * default 10), and at 8x8 that rounded to zero rows, so lvgl_init() asserted
	 * "lv_display_set_buffers: h != 0 (the buffer is too small)" on every boot. */
	lvgl_dummy_display: lvgl-dummy-dc {
		compatible = "zephyr,dummy-dc";
		status = "okay";
		width = <64>;
		height = <64>;
	};

	/*
	 * Board-specific GPIO/ADC wiring with no dedicated driver of its own —
	 * `zephyr,user` is Zephyr's standard place for exactly this (see e.g.
	 * nRF Connect SDK's own battery-voltage samples for the io-channels half of
	 * this pattern). Read via DT_PATH(zephyr_user) + GPIO_DT_SPEC_GET /
	 * ADC_DT_SPEC_GET_BY_IDX in battery.c and epaper.c.
	 */
	zephyr_user: zephyr,user {
		io-channels = <&adc 7>;
		dc-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;   /* D3 */
		rst-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;    /* D0 */
		/* D5, not D2. The pin table in this file's header (transcribed from Seeed's
		 * wiki) said BUSY=D2, and that was wrong for this board: a boot-time probe
		 * (epd_probe_busy_line in epaper_ssd1683.c) sampled P0.28 978 times across a
		 * software reset and never once saw it asserted, and the pin was confirmed
		 * against the physical board as D5. Every panel operation was consequently
		 * falling through to a 4-second blind wait — see epd_wait_busy(). */
		busy-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>; /* D5 — datasheet: high = busy */
		battery-enable-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>; /* low = divider enabled */
		/* ACTIVE_LOW so gpio_pin_get_dt() reads 1 (active) exactly while the BQ25101
		 * is charging, matching battery.c's bool out-param. No PULL flag: the CHG
		 * pin is already driven push-pull-ish by the charger IC through the LED's
		 * pull path on the XIAO module itself (same reasoning as busy-gpios above
		 * not needing one — an actively-driven signal, not a floating input). */
		charge-status-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;

		/* One tactile button per checklist row (up to 5, the number of free GPIOs —
		 * see header comment). Each ties its pin to GND when pressed; ACTIVE_LOW +
		 * PULL_UP means the pin reads high (inactive) via the SoC's internal pull-up
		 * when open. The pin's own edge interrupt (configured in button.c, not here)
		 * is what wakes the SoC from DEEP_SLEEP — no separate "wakeup-source"
		 * devicetree property is needed because this firmware sleeps in Zephyr's
		 * deepest *System ON* low-power state, not System OFF, and GPIO interrupts
		 * already wake the CPU for free from there (see prj.conf's comment on why
		 * System OFF was deliberately avoided). Named individually (not a `gpios`
		 * array, and not `gpio-keys` + CONFIG_INPUT) to keep each one a plain
		 * GPIO_DT_SPEC_GET(DT_PATH(zephyr_user), row0_button_gpios)-style spec in
		 * button.c, matching every other pin in this node. */
		row0-button-gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  /* D4 */
		/* Moved off D5, which turned out to be the panel's BUSY line (see busy-gpios
		 * above) — the two cannot share a pin. D2/P0.28 is free precisely because it
		 * was the pin BUSY was mistakenly assigned to.
		 *
		 * NOTE: this is a wiring change, not just a devicetree change. If a physical
		 * button for row 1 is already soldered to D5, it has to move to D2 as well,
		 * otherwise pressing it fights the panel driving BUSY. */
		row1-button-gpios = <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* D2 */
		row2-button-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* D6 */
		row3-button-gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* D7 */
		row4-button-gpios = <&gpio1 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* D9 */
	};
};
